---
import '../styles/global.css';

interface Props {
  title?: string;
  description?: string;
  lang?: 'en' | 'ja';
}

const {
  lang = 'en',
  title = lang === 'en' ? 'iray-tno | Projects & Open Source' : 'iray-tno | プロジェクト & OSS',
  description = lang === 'en'
    ? 'Personal portal and open-source project directory of iray-tno, including Envarly, Hozo, and developer utilities.'
    : 'iray-tno のオープンソースプロジェクトおよびツールのポータルページです。Envarly や Hozo などの開発物を掲載しています。',
} = Astro.props;

const canonicalURL = new URL(Astro.url.pathname, Astro.site ?? 'https://iray-tno.github.io');
const siteName = 'iray-tno';

const enURL = new URL('/', Astro.site ?? 'https://iray-tno.github.io').toString();
const jaURL = new URL('/ja/', Astro.site ?? 'https://iray-tno.github.io').toString();

const jsonLd = {
  '@context': 'https://schema.org',
  '@type': 'WebSite',
  'name': siteName,
  'alternateName': ['tanao', 'iray-tno Projects'],
  'url': 'https://iray-tno.github.io/',
  'inLanguage': lang === 'en' ? 'en-US' : 'ja-JP',
  'author': {
    '@type': 'Person',
    'name': 'iray-tno',
    'alternateName': 'tanao',
    'url': 'https://github.com/iray-tno',
  },
};
---

<!doctype html>
<html lang={lang} class="scroll-smooth">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="canonical" href={canonicalURL} />
    <meta name="generator" content={Astro.generator} />

    <!-- Hreflang Tags for SEO -->
    <link rel="alternate" hreflang="en" href={enURL} />
    <link rel="alternate" hreflang="ja" href={jaURL} />
    <link rel="alternate" hreflang="x-default" href={enURL} />

    <!-- Primary Meta Tags -->
    <title>{title}</title>
    <meta name="title" content={title} />
    <meta name="description" content={description} />
    <meta name="author" content="iray-tno" />

    <!-- Open Graph / Facebook -->
    <meta property="og:type" content="website" />
    <meta property="og:url" content={canonicalURL} />
    <meta property="og:site_name" content={siteName} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />

    <!-- Twitter -->
    <meta property="twitter:card" content="summary" />
    <meta property="twitter:url" content={canonicalURL} />
    <meta property="twitter:title" content={title} />
    <meta property="twitter:description" content={description} />

    <!-- Schema.org Structured Data for Google Site Name -->
    <script type="application/ld+json" set:html={JSON.stringify(jsonLd)} />
  </head>
  <body class="bg-zinc-50 text-zinc-900 dark:bg-zinc-950 dark:text-zinc-100 min-h-screen flex flex-col antialiased selection:bg-indigo-500 selection:text-white transition-colors duration-200">
    <div class="fixed inset-0 -z-10 pointer-events-none opacity-40 dark:opacity-20 [background-image:radial-gradient(ellipse_at_top,_var(--tw-gradient-stops))] from-indigo-200 via-transparent to-transparent dark:from-indigo-900"></div>

    <header class="border-b border-zinc-200/80 dark:border-zinc-800/80 backdrop-blur-md sticky top-0 z-50 bg-white/70 dark:bg-zinc-950/70">
      <div class="max-w-5xl mx-auto px-4 sm:px-6 h-16 flex items-center justify-between">
        <a href={lang === 'en' ? '/' : '/ja/'} class="flex items-center gap-2.5 font-bold text-lg tracking-tight group">
          <span class="inline-flex items-center justify-center w-8 h-8 rounded-lg bg-zinc-900 text-white dark:bg-zinc-100 dark:text-zinc-900 font-mono text-sm transition-transform group-hover:scale-105">
            i
          </span>
          <span class="group-hover:text-indigo-600 dark:group-hover:text-indigo-400 transition-colors">
            iray-tno
          </span>
        </a>

        <div class="flex items-center gap-4 sm:gap-6 text-sm font-medium">
          <!-- Language Switcher -->
          <div class="inline-flex items-center rounded-lg border border-zinc-200 dark:border-zinc-800 p-0.5 bg-zinc-100/70 dark:bg-zinc-900/70 text-xs">
            <a
              href="/"
              class:list={[
                'px-2 py-1 rounded-md transition-all',
                lang === 'en'
                  ? 'bg-white dark:bg-zinc-800 text-zinc-900 dark:text-zinc-100 font-semibold shadow-xs'
                  : 'text-zinc-500 dark:text-zinc-400 hover:text-zinc-900 dark:hover:text-zinc-200',
              ]}
            >
              EN
            </a>
            <a
              href="/ja/"
              class:list={[
                'px-2 py-1 rounded-md transition-all',
                lang === 'ja'
                  ? 'bg-white dark:bg-zinc-800 text-zinc-900 dark:text-zinc-100 font-semibold shadow-xs'
                  : 'text-zinc-500 dark:text-zinc-400 hover:text-zinc-900 dark:hover:text-zinc-200',
              ]}
            >
              JA
            </a>
          </div>

          <nav class="flex items-center gap-3 sm:gap-4">
            <a
              href="https://github.com/iray-tno"
              target="_blank"
              rel="noopener noreferrer"
              class="text-zinc-600 dark:text-zinc-400 hover:text-zinc-900 dark:hover:text-white transition-colors flex items-center gap-1.5"
            >
              <svg class="w-4 h-4 fill-current" viewBox="0 0 24 24">
                <path fill-rule="evenodd" clip-rule="evenodd" d="M12 2C6.477 2 2 6.484 2 12.017c0 4.425 2.865 8.18 6.839 9.504.5.092.682-.217.682-.483 0-.237-.008-.868-.013-1.703-2.782.605-3.369-1.343-3.369-1.343-.454-1.158-1.11-1.466-1.11-1.466-.908-.62.069-.608.069-.608 1.003.07 1.53 1.032 1.53 1.032.892 1.53 2.341 1.088 2.91.832.092-.647.35-1.088.636-1.338-2.22-.253-4.555-1.113-4.555-4.951 0-1.093.39-1.988 1.029-2.688-.103-.253-.446-1.272.098-2.65 0 0 .84-.27 2.75 1.026A9.564 9.564 0 0112 6.844c.85.004 1.705.115 2.504.337 1.909-1.296 2.747-1.027 2.747-1.027.546 1.379.202 2.398.1 2.651.64.7 1.028 1.595 1.028 2.688 0 3.848-2.339 4.695-4.566 4.943.359.309.678.92.678 1.855 0 1.338-.012 2.419-.012 2.747 0 .268.18.58.688.482A10.019 10.019 0 0022 12.017C22 6.484 17.522 2 12 2z" />
              </svg>
              <span class="hidden sm:inline">GitHub</span>
            </a>
            <a
              href="https://twitter.com/iray_tno"
              target="_blank"
              rel="noopener noreferrer"
              class="text-zinc-600 dark:text-zinc-400 hover:text-zinc-900 dark:hover:text-white transition-colors"
            >
              X
            </a>
          </nav>
        </div>
      </div>
    </header>

    <main class="flex-1">
      <slot />
    </main>

    <footer class="border-t border-zinc-200/80 dark:border-zinc-800/80 py-8 text-center text-xs text-zinc-500 dark:text-zinc-400">
      <div class="max-w-5xl mx-auto px-4 flex flex-col sm:flex-row items-center justify-between gap-4">
        <div>
          © {new Date().getFullYear()} iray-tno. All rights reserved.
        </div>
        <div class="flex items-center gap-4">
          <a href="https://github.com/iray-tno" class="hover:underline">GitHub</a>
          <a href="https://twitter.com/iray_tno" class="hover:underline">X (@iray_tno)</a>
          <a href="http://chiranoura.nobody.jp/" class="hover:underline">Blog</a>
        </div>
      </div>
    </footer>
  </body>
</html>
