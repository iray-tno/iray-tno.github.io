---
import Layout from '../../layouts/Layout.astro';
import ProjectCard from '../../components/ProjectCard.astro';
import { projects } from '../../data/projects';

const featuredProjects = projects.filter((p) => p.featured);
const otherProjects = projects.filter((p) => !p.featured);
---

<Layout
  lang="ja"
  title="iray-tno | プロジェクト & OSS"
  description="iray-tno のオープンソースプロジェクトおよびツールのポータルページです。Envarly や Hozo などの開発物を掲載しています。"
>
  <div class="max-w-5xl mx-auto px-4 sm:px-6 py-12 sm:py-20">
    <!-- Hero Section -->
    <section class="mb-16 sm:mb-24">
      <div class="flex flex-col sm:flex-row items-start sm:items-center gap-6 sm:gap-8">
        <div class="relative">
          <img
            src="https://avatars.githubusercontent.com/u/5704673?v=4"
            alt="iray-tno"
            class="w-24 h-24 sm:w-28 sm:h-28 rounded-2xl border-2 border-zinc-200 dark:border-zinc-800 shadow-sm object-cover"
            loading="eager"
          />
          <span class="absolute -bottom-2 -right-2 px-2 py-0.5 rounded-full text-xs font-mono bg-zinc-900 text-white dark:bg-white dark:text-zinc-900 shadow">
            💊
          </span>
        </div>

        <div class="space-y-3">
          <div class="flex items-center gap-3">
            <h1 class="text-3xl sm:text-4xl font-extrabold tracking-tight text-zinc-900 dark:text-white">
              iray-tno
            </h1>
            <span class="text-xs px-2 py-0.5 rounded-full font-mono bg-indigo-50 text-indigo-700 dark:bg-indigo-950/70 dark:text-indigo-300 border border-indigo-200 dark:border-indigo-800">
              tanao
            </span>
          </div>

          <p class="text-base sm:text-lg text-zinc-600 dark:text-zinc-400 font-medium">
            Side quests may have side effects.
          </p>

          <p class="text-sm text-zinc-500 dark:text-zinc-400 max-w-xl leading-relaxed">
            個人開発のツールやオープンソースソフトウェアのポータルページです。
            Windows ユーティリティ、UI コンパイラ、ライブラリなどを開発しています。
          </p>

          <div class="flex items-center gap-3 pt-2">
            <a
              href="https://github.com/iray-tno"
              target="_blank"
              rel="noopener noreferrer"
              class="inline-flex items-center gap-2 px-4 py-2 rounded-xl text-xs font-semibold bg-zinc-900 text-white dark:bg-zinc-100 dark:text-zinc-900 hover:opacity-90 transition-opacity"
            >
              <span>GitHub Profile</span>
              <svg class="w-3.5 h-3.5 fill-current" viewBox="0 0 24 24">
                <path fill-rule="evenodd" clip-rule="evenodd" d="M12 2C6.477 2 2 6.484 2 12.017c0 4.425 2.865 8.18 6.839 9.504.5.092.682-.217.682-.483 0-.237-.008-.868-.013-1.703-2.782.605-3.369-1.343-3.369-1.343-.454-1.158-1.11-1.466-1.11-1.466-.908-.62.069-.608.069-.608 1.003.07 1.53 1.032 1.53 1.032.892 1.53 2.341 1.088 2.91.832.092-.647.35-1.088.636-1.338-2.22-.253-4.555-1.113-4.555-4.951 0-1.093.39-1.988 1.029-2.688-.103-.253-.446-1.272.098-2.65 0 0 .84-.27 2.75 1.026A9.564 9.564 0 0112 6.844c.85.004 1.705.115 2.504.337 1.909-1.296 2.747-1.027 2.747-1.027.546 1.379.202 2.398.1 2.651.64.7 1.028 1.595 1.028 2.688 0 3.848-2.339 4.695-4.566 4.943.359.309.678.92.678 1.855 0 1.338-.012 2.419-.012 2.747 0 .268.18.58.688.482A10.019 10.019 0 0022 12.017C22 6.484 17.522 2 12 2z" />
              </svg>
            </a>
            <a
              href="https://twitter.com/iray_tno"
              target="_blank"
              rel="noopener noreferrer"
              class="inline-flex items-center gap-1.5 px-4 py-2 rounded-xl text-xs font-semibold bg-zinc-100 text-zinc-800 dark:bg-zinc-800 dark:text-zinc-200 hover:bg-zinc-200 dark:hover:bg-zinc-700 transition-colors"
            >
              <span>X (@iray_tno)</span>
            </a>
          </div>
        </div>
      </div>
    </section>

    <!-- Featured Projects -->
    <section class="mb-16">
      <div class="mb-6">
        <h2 class="text-xl sm:text-2xl font-bold tracking-tight text-zinc-900 dark:text-zinc-100">
          Featured Projects
        </h2>
        <p class="text-xs sm:text-sm text-zinc-500 dark:text-zinc-400 mt-1">
          主要なアプリケーションとプロジェクト
        </p>
      </div>

      <div class="grid grid-cols-1 md:grid-cols-2 gap-6">
        {featuredProjects.map((project) => (
          <ProjectCard project={project} lang="ja" />
        ))}
      </div>
    </section>

    <!-- Other Projects -->
    {otherProjects.length > 0 && (
      <section class="mb-16">
        <div class="mb-6">
          <h2 class="text-lg sm:text-xl font-bold tracking-tight text-zinc-900 dark:text-zinc-100">
            Other Projects & Tools
          </h2>
          <p class="text-xs sm:text-sm text-zinc-500 dark:text-zinc-400 mt-1">
            ライブラリ・スクリプト・ツール
          </p>
        </div>

        <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 gap-4">
          {otherProjects.map((project) => (
            <ProjectCard project={project} lang="ja" />
          ))}
        </div>
      </section>
    )}
  </div>
</Layout>
